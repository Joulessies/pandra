{
  "expo": {
    "name": "pandra",
    "slug": "pandra-o7rzxlghqceu8bko7hoom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pandra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.joulessies.pandra",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.joulessies.pandra"
        ]
      }
    },
    "android": {
      "package": "com.joulessies.pandra",
      "adaptiveIcon": {
        "backgroundColor": "#92A498",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.joulessies.pandra",
          "widgets": [
            {
              "name": "PandraWidget",
              "displayName": "Pandra Widget",
              "description": "AI-crafted widgets from Pandra",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PandraSmallWidget",
              "label": "Pandra Widget",
              "description": "AI-crafted widgets from Pandra",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PandraWideWidget",
              "label": "Pandra Widget (Wide)",
              "description": "AI-crafted wide widget from Pandra",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-work-runtime-fix.js",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ad070ca-1bb2-47ad-b8fe-d2519c743a34",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.joulessies.pandra.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.joulessies.pandra"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "joulessies"
  }
}
